# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/manobalam

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_hex_secret
JWT_REFRESH_SECRET=replace_with_64_byte_hex_secret

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local:  redis://127.0.0.1:6379
# Render: rediss://<user>:<password>@<host>:6379
REDIS_URL=redis://127.0.0.1:6379

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# https://dashboard.razorpay.com → Settings → API Keys
# Use test keys (rzp_test_*) for development
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# https://dashboard.razorpay.com → Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Email ────────────────────────────────────────────────────────────────────
# Local development: console. Production: smtp or resend.
EMAIL_DELIVERY_MODE=console
# Use a sender address authorized by your email provider.
EMAIL_FROM="ManoBalam <noreply@your-domain.com>"

# SMTP mode uses authenticated, encrypted SMTP. Use 465 for implicit TLS or 587 for STARTTLS.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password

# Required only for resend mode.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── MSG91 (SMS/OTP) — optional ───────────────────────────────────────────────
# Required only if using SMS-based OTP. Leave blank to skip SMS delivery.
# https://msg91.com/dashboard
MSG91_API_KEY=

# ─── WebRTC TURN Server ───────────────────────────────────────────────────────
# Metered TURN credentials endpoint — returns a ready-to-use iceServers array
# https://<app>.metered.live/api/v1/turn/credentials?apiKey=<key>
METERED_TURN_CREDENTIALS_URL=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ─── Encryption ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Used for encrypting sensitive data like bank account numbers
ENCRYPTION_KEY=replace_with_64_byte_hex_encryption_key
